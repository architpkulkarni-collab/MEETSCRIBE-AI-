# ══════════════════════════════════════════════════════
# AirScribe AI Server — Environment Configuration
# ══════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.

# ── HuggingFace Token ──
# Required for pyannote.audio speaker diarization models.
# Get a free token at https://huggingface.co/settings/tokens
# You must also accept the model license at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your_huggingface_token_here

# ── Whisper Model ──
# Options: tiny, base, small, medium, large
# 'base' is the best balance for RTX 3050 (4GB VRAM)
WHISPER_MODEL=base

# ── MongoDB ──
# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://your_user:your_pass@cluster.mongodb.net/airscribe?retryWrites=true&w=majority
DB_NAME=airscribe

# ── Speaker Recognition ──
# Cosine similarity threshold for matching voices (0.0 to 1.0)
# Higher = stricter matching, fewer false positives
# Lower = more lenient matching, fewer "Unknown Speaker" labels
SPEAKER_CONFIDENCE_THRESHOLD=0.70

# ── Voice Enrollment ──
# Minimum audio duration (seconds) for a valid voice enrollment
MIN_ENROLLMENT_DURATION=15

# Maximum upload size for audio files (in megabytes)
MAX_AUDIO_SIZE_MB=10

# ── AI Server ──
AI_HOST=0.0.0.0
AI_PORT=5001
AI_DEBUG=True

# ── Encrypted Note Store (Feature #6) ──
# CRITICAL: These keys protect all note content. Losing them = permanent data loss.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the actual values to version control.

# 64-character hex string — the master encryption secret
NOTE_ENCRYPTION_MASTER_KEY=generate_me_with_secrets_token_hex_32

# 32-character hex string — salt for key derivation
NOTE_ENCRYPTION_SALT=generate_me_with_secrets_token_hex_16

